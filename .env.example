# Gateway connection
EXPO_PUBLIC_GATEWAY_HOST=          # Gateway hostname or IP (e.g., raspberry-pi.tail1234.ts.net)
EXPO_PUBLIC_GATEWAY_PORT=18789     # Gateway WebSocket port (default: 18789)

# Optional: Pre-configured auth token (for CI/testing)
EXPO_PUBLIC_AUTH_TOKEN=            # OPENCLAW_GATEWAY_TOKEN value

# Optional: Tailscale integration
EXPO_PUBLIC_TAILSCALE_HOSTNAME=   # Tailscale MagicDNS hostname (e.g., raspberry-pi.tail1234.ts.net)

# Optional: Feature flags
EXPO_PUBLIC_DEBUG_MODE=false       # Enable debug screens and verbose logging
